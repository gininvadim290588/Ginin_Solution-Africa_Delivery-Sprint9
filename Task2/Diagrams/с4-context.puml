@startuml c4-context
!pragma layout smetana
!include <C4/C4_Context>
LAYOUT_TOP_DOWN()
title Africa Delivery — C4 Context | пилот Нигерия / Кения
Person(buyer, "Покупатель", "Каталог, заказ, оплата, получение")
Person(seller, "Продавец", "Товары, остатки, подтверждение заказа")
Person(ops, "Оператор / сотрудник ПВЗ", "Модерация, доставка, выдача, исключения")
Person(ceo, "CEO", "Продажи и качество пилота")
Person(cfo, "CFO / финансовый оператор", "Сверка оплат, возвратов и выплат")
Person(sre, "Эксплуатация", "Наблюдение, восстановление, инциденты")
System(ad, "Africa Delivery", "Посредник покупатель—продавец: каталог, заказы, расчёты, статусы. Отдельные контуры данных NG/KE; логистика и платежи у партнёров.")
System_Ext(mpesa, "M-Pesa", "Платежи и статусы в Кении; лицензированный договор")
System_Ext(flutter, "Flutterwave", "Приём платежей в Нигерии; сверка / выплаты по договору")
System_Ext(paystack, "Paystack [после MVP]", "Резервный платёжный адаптер; контракт и тариф ещё не выбраны")
System_Ext(sendbox, "Sendbox", "Нигерия: заявка на доставку и базовый статус")
System_Ext(sendy, "Sendy [кандидат]", "Кения: указан в кейсе; действующий API/партнёра необходимо проверить")
System_Ext(wa, "WhatsApp Business API", "Сообщения продавцам и покупателям; правила и тариф BSP/Meta")
System_Ext(gateway, "SMS/USSD-шлюз", "SMS с кодом/статусом; USSD статуса/выдачи — при доступном short code")
Rel(buyer, ad, "Смотрит товары, оформляет и проверяет заказ", "Android / мобильный web, HTTPS")
Rel(seller, wa, "Присылает товары/остатки; получает заказ", "WhatsApp")
Rel(wa, ad, "Передаёт сообщения и статусы отправки", "HTTPS / webhook")
Rel(ad, wa, "Отправляет сервисные уведомления", "HTTPS API")
Rel(ops, ad, "Проверяет продавца, подтверждает выдачу, обрабатывает исключения", "Защищённый операторский экран")
Rel(ceo, ad, "Смотрит оборот, заказы и проблемы", "Отчёт / кабинет")
Rel(cfo, ad, "Сверяет расчёты и управляет исключениями выплат", "Отчёт / защищённый экран")
Rel(sre, ad, "Следит за метриками, восстанавливает работу", "Операционные инструменты")
BiRel(ad, mpesa, "Инициирует платёж; проверяет подтверждение / расчёты", "HTTPS API / callback")
BiRel(ad, flutter, "Инициирует платёж; сверяет статусы / выплаты", "HTTPS API / webhook")
BiRel(ad, paystack, "Планируемый маршрут платежа и сверки; выключен в MVP", "HTTPS API / webhook")
BiRel(ad, sendbox, "Передаёт доставку; получает подтверждение / статус", "HTTPS API")
BiRel(ad, sendy, "Планируемая заявка / статус; подключение после проверки", "HTTPS API")
Rel(ad, gateway, "Отправляет SMS; обслуживает разрешённые USSD-запросы", "HTTPS API")
Rel(gateway, buyer, "Передаёт код выдачи / статус заказа", "SMS / USSD при GSM-связи")
Rel(buyer, gateway, "Запрашивает статус / код; без интернета, при наличии GSM", "USSD / SMS")
SHOW_LEGEND()
footer Источники: A3 с.2 (PSP), A4 (каналы), A5 с.2 (build/buy), A8 (граница), кейс (Sendbox/Sendy). Assumptions: Sendy и USSD не считаются заключёнными договорами; Paystack вне MVP.
